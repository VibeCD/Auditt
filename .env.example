# NVIDIA NIM API Key (REQUIRED)
# Get your key from https://integrate.api.nvidia.com
# SECURITY: This key MUST remain server-side only. Never expose to frontend.
NIM_API_KEY=nvapi-your-key-here

# Supabase (optional; required only when cloud-save is enabled)
# SECURITY: service role key MUST stay server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
